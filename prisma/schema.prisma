// Avenues Perfumes — data model
//
// Money convention: every monetary column is an Int of PAISE (₹1 = 100 paise).
// Integers keep arithmetic exact; formatting to "₹1,199" happens at the edge
// (see src/lib/format.ts). Never introduce a Float for money.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum OrderStatus {
  PENDING // created, awaiting payment (prepaid) or confirmation (COD)
  CONFIRMED
  PACKED
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  RTO // COD parcel refused / undeliverable, coming back to origin
  FAILED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum CouponType {
  FLAT // valuePaise is a rupee amount off
  PERCENTAGE // valuePercent is % off, capped by maxDiscountPaise
}

enum ShipmentStatus {
  CREATED
  PICKUP_PENDING
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO
  CANCELLED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum EnquirySubject {
  ORDER_ISSUE
  PRODUCT_ENQUIRY
  BULK_CORPORATE
  OTHER
}

enum EnquiryStatus {
  NEW
  REPLIED
  CLOSED
}

// ---------------------------------------------------------------------------
// Identity — NextAuth (Auth.js) core + our extensions
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  passwordHash  String? // null for OAuth-only accounts
  role          Role      @default(CUSTOMER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  addresses          Address[]
  orders             Order[]
  wishlist           WishlistItem[]
  cart               Cart?
  passwordResets     PasswordResetToken[]
  couponRedemptions  CouponRedemption[]
  stockNotifications StockNotification[]
  reviews            Review[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256 of the emailed token; the raw token is never stored
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id        String      @id @default(cuid())
  userId    String
  type      AddressType @default(HOME)
  fullName  String
  phone     String
  altPhone  String?
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  country   String      @default("India")
  isDefault Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Product {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  tagline       String // "Bold. Fresh. Powerful."
  highlight     String // "Make your presence unforgettable."
  description   String  @db.Text
  concentration String  @default("Eau De Parfum")
  gender        Gender

  // Fragrance pyramid — three ordered arrays so the storefront can render
  // top/heart/base without parsing anything.
  notesTop   String[]
  notesHeart String[]
  notesBase  String[]

  occasions String[]
  whyChoose String[]
  howToUse  String   @db.Text
  caution   String   @db.Text
  longevity String   @default("8-10 hours")

  // Legal Metrology (Packaged Commodities Rules) — shown on the PDP.
  countryOfOrigin String @default("India")

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)
  sortOrder  Int     @default(0)

  // Denormalised review aggregates so product cards and sorting never need a
  // join. Recomputed by recalcProductRating() whenever a review changes state.
  avgRating   Float @default(0)
  reviewCount Int   @default(0)

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants     Variant[]
  images       ProductImage[]
  collections  ProductCollection[]
  wishlistedBy WishlistItem[]
  reviews      Review[]

  @@index([isActive, sortOrder])
  @@index([gender])
}

model Variant {
  id         String  @id @default(cuid())
  productId  String
  size       String // "50ml", "100ml" — also the Legal Metrology net quantity
  sku        String  @unique
  mrpPaise   Int // struck-through price, inclusive of all taxes
  pricePaise Int // what the customer actually pays
  stock      Int     @default(0)
  // Shipped weight including carton, in grams. Delhivery requires it on
  // shipment creation and prices slabs off it.
  weightGrams Int    @default(250)
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  stockNotifications StockNotification[]

  @@unique([productId, size])
  @@index([productId, sortOrder])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  publicId  String? // Cloudinary public_id, so admin deletes can purge the CDN too
  alt       String
  position  Int     @default(0)
  isPrimary Boolean @default(false)
  width     Int?
  height    Int?

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

// Collections exist so a "Women" or "Unisex" edit can be merchandised later
// with zero code changes — the storefront reads them from the DB.
model Collection {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  subtitle    String?
  description String? @db.Text
  imageUrl    String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductCollection[]

  @@index([isActive, sortOrder])
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
}

model StockNotification {
  id         String    @id @default(cuid())
  variantId  String
  email      String
  userId     String?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([variantId, email])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id        String @id @default(cuid())
  productId String
  userId    String

  rating Int // 1-5, validated at the API boundary
  title  String?
  body   String  @db.Text

  // Set at submission time by checking for a DELIVERED order containing this
  // product. Stored rather than derived so the badge survives order edits.
  isVerifiedBuyer Boolean      @default(false)
  status          ReviewStatus @default(PENDING)

  adminNote String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  moderatedAt DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId]) // one review per customer per fragrance
  @@index([productId, status])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Wishlist & cart
// ---------------------------------------------------------------------------

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Cart {
  id     String @id @default(cuid())
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
}

// ---------------------------------------------------------------------------
// Coupons
// ---------------------------------------------------------------------------

model Coupon {
  id               String     @id @default(cuid())
  code             String     @unique // stored upper-cased; lookups upper-case the input
  description      String?
  type             CouponType
  valuePaise       Int? // FLAT only
  valuePercent     Int? // PERCENTAGE only, 1-100
  minOrderPaise    Int        @default(0)
  maxDiscountPaise Int? // caps a PERCENTAGE coupon
  usageLimit       Int? // total redemptions allowed, null = unlimited
  perUserLimit     Int? // redemptions per user, null = unlimited
  usedCount        Int        @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]

  @@index([isActive])
}

model CouponRedemption {
  id          String   @id @default(cuid())
  couponId    String
  userId      String?
  orderId     String   @unique
  amountPaise Int
  createdAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique // AVN-XXXXXX, shown to the customer
  userId        String? // null for guest checkout
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  // Sequential, gapless, GST-ready. Allocated from StoreSetting.invoiceNextNumber
  // inside a transaction at confirmation — never at creation, so abandoned
  // carts don't burn invoice numbers.
  invoiceNumber String?   @unique
  invoicedAt    DateTime?

  // Contact — captured even for guest checkout.
  email String
  phone String

  // Address snapshot. Denormalised on purpose: editing a saved Address later
  // must not rewrite history on an already-shipped order.
  shipName     String
  shipPhone    String
  shipAltPhone String?
  shipLine1    String
  shipLine2    String?
  shipLandmark String?
  shipCity     String
  shipState    String
  shipPincode  String
  shipCountry  String  @default("India")

  // Every figure below is computed server-side from DB prices. The client cart
  // is treated as a list of (variantId, qty) intents and nothing more.
  subtotalPaise Int
  discountPaise Int @default(0)
  shippingPaise Int @default(0)
  codFeePaise   Int @default(0)
  totalPaise    Int

  couponId   String?
  couponCode String?

  // Inventory reservation. Stock is decremented atomically when the order is
  // created and released if a prepaid order is never paid. These two timestamps
  // make the operation idempotent under webhook retries.
  stockCommittedAt DateTime?
  stockReleasedAt  DateTime?
  // After this instant an unpaid prepaid order is eligible for stock release.
  paymentExpiresAt DateTime?

  customerNote String? @db.Text
  adminNote    String? @db.Text
  cancelReason String? @db.Text

  // Consent captured at checkout, for dispute handling.
  termsAcceptedAt DateTime?

  placedAt    DateTime?
  cancelledAt DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon        Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  refunds       Refund[]
  shipment      Shipment?
  redemption    CouponRedemption?
  returnRequest ReturnRequest?

  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([phone])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  variantId String?

  // Product snapshot — an admin renaming or deleting a product must not
  // corrupt a historical invoice.
  productName String
  productSlug String
  variantSize String
  sku         String
  imageUrl    String?

  mrpPaise       Int
  unitPricePaise Int
  quantity       Int
  totalPaise     Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Payment {
  id       String        @id @default(cuid())
  orderId  String
  provider String        @default("razorpay")
  status   PaymentStatus @default(PENDING)

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  amountPaise Int
  currency    String  @default("INR")
  method      String? // upi / card / netbanking, as reported by Razorpay

  errorCode        String?
  errorDescription String?

  raw Json? // full webhook/verify payload, kept for reconciliation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Refund {
  id      String       @id @default(cuid())
  orderId String
  status  RefundStatus @default(PENDING)

  razorpayRefundId  String? @unique
  razorpayPaymentId String?

  amountPaise Int
  reason      String? @db.Text
  notes       String? @db.Text
  raw         Json?

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ReturnRequest {
  id      String       @id @default(cuid())
  orderId String       @unique
  status  ReturnStatus @default(REQUESTED)

  reason    String  @db.Text
  adminNote String? @db.Text

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ---------------------------------------------------------------------------
// Shipping (Delhivery)
// ---------------------------------------------------------------------------

model Shipment {
  id      String @id @default(cuid())
  orderId String @unique

  provider     String         @default("delhivery")
  waybill      String?        @unique // Delhivery AWB
  status       ShipmentStatus @default(CREATED)
  statusDetail String?
  courierName  String?
  trackingUrl  String?

  expectedDeliveryAt DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  lastSyncedAt       DateTime?

  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events ShipmentEvent[]

  @@index([status])
}

model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  status     String
  detail     String?
  location   String?
  occurredAt DateTime

  createdAt DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, status, occurredAt])
  @@index([shipmentId, occurredAt])
}

// ---------------------------------------------------------------------------
// Support & marketing
// ---------------------------------------------------------------------------

model Enquiry {
  id      String         @id @default(cuid())
  name    String
  email   String
  phone   String?
  subject EnquirySubject @default(OTHER)
  message String         @db.Text
  source  String? // "contact-page", "footer"

  status    EnquiryStatus @default(NEW)
  adminNote String?       @db.Text
  handledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([subject])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String? // "footer", "landing"
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Store settings — a single row (id = 1).
//
// Everything the founder must be able to change without a deploy lives here:
// shipping economics, COD policy, support channels, and the statutory
// manufacturer details that Legal Metrology requires on a product page.
// ---------------------------------------------------------------------------

model StoreSetting {
  id Int @id @default(1)

  // Shipping economics
  shippingFlatPaise         Int     @default(7900) // ₹79
  freeShippingThresholdPaise Int    @default(99900) // free at ₹999 and above
  codEnabled                Boolean @default(true)
  codFeePaise               Int     @default(4900) // ₹49
  codMaxOrderPaise          Int? // refuse COD above this value; null = no cap

  // Delhivery
  delhiveryPickupName String?

  // Support channels — rendered by the floating WhatsApp button, the footer,
  // and the per-product "Enquire on WhatsApp" link.
  whatsappNumber String? // E.164 without '+', e.g. 919876543210
  supportEmail   String  @default("support@avenuesperfumes.com")
  supportPhone   String?

  // Legal Metrology / statutory
  manufacturerName    String  @default("Avenues Perfumes")
  manufacturerAddress String  @default("") @db.Text
  customerCareEmail   String  @default("care@avenuesperfumes.com")
  customerCarePhone   String?
  gstin               String?

  // Sequential invoice numbering. `invoiceNextNumber` is read-and-incremented
  // inside the order-confirmation transaction, which is what keeps the series
  // gapless under concurrency.
  invoicePrefix     String @default("AVN")
  invoiceNextNumber Int    @default(1)

  // Social
  instagramUrl String?
  facebookUrl  String?

  updatedAt DateTime @updatedAt
}
