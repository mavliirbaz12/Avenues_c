####################################################################
# Avenues Perfumes — environment
#
# Copy to `.env` for local dev. Every key below is documented; the ones
# marked REQUIRED must be present or the app will refuse to boot (see
# src/lib/env.ts). Integrations left blank fall back to MOCK MODE, which
# lets the entire purchase + shipping flow be tested without vendor keys.
####################################################################

# ─── Database ─────────────────────────────────────────────────────
# REQUIRED. PostgreSQL connection string.
#   Local (docker compose up -d):
#     postgresql://avenues:avenues@localhost:5433/avenues?schema=public
#   Railway: copy DATABASE_URL from the Postgres service → Variables.
#   AWS RDS: postgresql://USER:PASS@HOST:5432/avenues?schema=public&sslmode=require
DATABASE_URL="postgresql://avenues:avenues@localhost:5433/avenues?schema=public"

# Optional. Direct (non-pooled) URL. Set this when DATABASE_URL points at a
# connection pooler (PgBouncer, Supabase pooler) so `prisma migrate` can still
# take an advisory lock. Leave unset on Railway/RDS.
# DIRECT_DATABASE_URL=""

# ─── App ──────────────────────────────────────────────────────────
# REQUIRED. Public origin, no trailing slash. Used for absolute URLs in
# emails, OpenGraph tags, sitemap, and Razorpay callbacks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Auth (NextAuth / Auth.js v5) ─────────────────────────────────
# REQUIRED. Signing secret for session JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# REQUIRED in production behind a proxy (Vercel sets this automatically).
# Tells Auth.js to trust the X-Forwarded-Host header.
AUTH_TRUST_HOST="true"

# Optional. Google OAuth — leave blank to hide the "Continue with Google"
# button entirely (the UI adapts; it does not render a dead button).
# Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
# Authorised redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Payments — Razorpay ──────────────────────────────────────────
# Blank ⇒ MOCK MODE: checkout simulates a successful/failed payment locally
# without contacting Razorpay. COD always works regardless.
# Dashboard → Settings → API Keys. Test keys start with `rzp_test_`.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# REQUIRED once RAZORPAY_KEY_ID is set. The secret you typed when creating the
# webhook, used to verify the X-Razorpay-Signature header.
# Dashboard → Settings → Webhooks → + Add New Webhook
#   URL:    {NEXT_PUBLIC_SITE_URL}/api/webhooks/razorpay
#   Events: payment.captured, payment.failed, order.paid, refund.processed
RAZORPAY_WEBHOOK_SECRET=""

# Mirrors RAZORPAY_KEY_ID for the browser Checkout.js handshake. Safe to
# expose — it is the publishable half of the pair. Keep the two in sync.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ─── Shipping — Delhivery ─────────────────────────────────────────
# Blank ⇒ MOCK MODE: pincode checks use an offline heuristic and shipments get
# a synthetic AWB that advances through the tracking timeline on demand.
# Delhivery One → Settings → API Setup → API Token.
DELHIVERY_API_TOKEN=""

# Staging: https://staging-express.delhivery.com
# Production: https://track.delhivery.com
DELHIVERY_BASE_URL="https://staging-express.delhivery.com"

# The pickup location name registered in your Delhivery account, exactly as
# spelled there. Delhivery rejects shipment creation if this does not match.
DELHIVERY_PICKUP_NAME=""

# Shared secret for the tracking push webhook, if you enable one.
#   URL: {NEXT_PUBLIC_SITE_URL}/api/webhooks/delhivery?token={this value}
DELHIVERY_WEBHOOK_SECRET=""

# ─── Images — Cloudinary ──────────────────────────────────────────
# Blank ⇒ admin image upload is disabled with an explanatory notice, and the
# storefront falls back to the engraved-bottle SVG placeholder.
# Dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder that uploads are filed under.
CLOUDINARY_FOLDER="avenues"

# ─── Email — Resend ───────────────────────────────────────────────
# Blank ⇒ MOCK MODE: emails are logged to the server console instead of sent,
# including the full password-reset link so the flow stays testable.
RESEND_API_KEY=""
# Must be a verified domain in Resend, or delivery silently fails.
EMAIL_FROM="Avenues <orders@avenuesperfumes.com>"
# Where contact-form submissions and new-order notifications land.
EMAIL_ADMIN="founder@avenuesperfumes.com"

# ─── Seed / bootstrap ─────────────────────────────────────────────
# The ADMIN account created by `npm run db:seed`. Change the password before
# seeding anything that faces the internet.
SEED_ADMIN_EMAIL="admin@avenuesperfumes.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Avenues Admin"

# ─── Marketing & analytics (optional) ─────────────────────────────
# Blank ⇒ no tracking script is injected at all (not an empty one). Fill these
# in the day you start running Instagram ads.
# GA4: Admin → Data Streams → Measurement ID, looks like G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=""
# Meta: Events Manager → Data Sources → your pixel's numeric ID
NEXT_PUBLIC_META_PIXEL_ID=""

# ─── Rate limiting (optional) ─────────────────────────────────────
# Auth and coupon endpoints are rate limited in-process by default, which is
# correct for a single instance. On multi-instance deploys set these to move
# the counters to Upstash Redis so limits are shared.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
