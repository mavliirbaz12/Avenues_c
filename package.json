{
  "name": "avenues-perfumes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run gen:sequence && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "gen:sequence": "node scripts/gen-bottle-sequence.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.7.4",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "cloudinary": "2.5.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.468.0",
    "motion": "13.1.0",
    "next": "15.5.23",
    "next-auth": "5.0.0-beta.25",
    "razorpay": "2.9.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "2.5.5",
    "zod": "3.24.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.10",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.23",
    "postcss": "8.4.49",
    "prisma": "6.19.3",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
